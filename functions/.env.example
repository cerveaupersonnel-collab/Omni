# Copy to functions/.env (deploy) and functions/.env.local (emulator).
# SHA-256 certificate fingerprint(s) of the Play App Signing key, comma separated.
# Play Console > Test and release > App integrity > App signing > SHA-256 fingerprint
PLAY_CERT_SHA256_DIGESTS=
# Set to false ONLY in .env.local for debug builds on the emulator.
ENFORCE_INTEGRITY=true
